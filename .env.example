# TrustDeal Environment Configuration
# Copy this to .env.local and fill in your values

# Sui Network Configuration
# devnet is faster and more stable than testnet
NEXT_PUBLIC_SUI_NETWORK=devnet

# Your deployed contract Package ID
# Get this from: `sui client publish --gas-budget 100000000`
NEXT_PUBLIC_PACKAGE_ID=YOUR_PACKAGE_ID_HERE

# Module name in your Move package (default: escrow)
NEXT_PUBLIC_MODULE_NAME=escrow

# TrustDeal Environment Configuration
# Copy this to .env.local and fill in your values

# === Sui Network Configuration ===
NEXT_PUBLIC_PACKAGE_ID=YOUR_PACKAGE_ID_HERE
NEXT_PUBLIC_MODULE_NAME=trustdeal
NEXT_PUBLIC_SUI_NETWORK=testnet

# === Contract Configuration ===
NEXT_PUBLIC_GAS_BUDGET=100000000
NEXT_PUBLIC_COIN_TYPE=0x2::sui::SUI

# === API Configuration ===
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_RPC_URL=https://fullnode.testnet.sui.io

# === Analytics ===
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# === Feature Flags ===
NEXT_PUBLIC_ENABLE_DISPUTES=false
NEXT_PUBLIC_ENABLE_MULTI_TOKEN=false
NEXT_PUBLIC_ENABLE_PREMIUM=false

# === Debug ===
NEXT_PUBLIC_DEBUG=false
